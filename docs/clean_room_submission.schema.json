{
  "$id": "urn:adls:cleanroom:submission:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attestation": {
      "additionalProperties": false,
      "properties": {
        "implemented_from_packet_only": {"const": true},
        "no_adls_source_or_tests_access": {"const": true},
        "no_reference_output_access": {"const": true}
      },
      "required": [
        "implemented_from_packet_only",
        "no_adls_source_or_tests_access",
        "no_reference_output_access"
      ],
      "type": "object"
    },
    "generated_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"},
    "implementation_id": {"pattern": "^[A-Za-z0-9._-]{1,80}$", "type": "string"},
    "input_manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "output_contract_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "protocol_version": {"const": "adls.cleanroom.protocol.v1"},
    "schema_version": {"const": "adls.cleanroom.submission.v1"},
    "sequence": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {"minimum": 1, "type": "integer"},
        "first_month": {"pattern": "^[0-9]{4}-[0-9]{2}$", "type": "string"},
        "last_month": {"pattern": "^[0-9]{4}-[0-9]{2}$", "type": "string"},
        "record_count": {"minimum": 1, "type": "integer"},
        "schema_version": {"const": "adls.cleanroom.frozen-month.v1"},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": [
        "byte_count",
        "first_month",
        "last_month",
        "record_count",
        "schema_version",
        "sha256"
      ],
      "type": "object"
    }
  },
  "required": [
    "attestation",
    "generated_at",
    "implementation_id",
    "input_manifest_sha256",
    "output_contract_sha256",
    "protocol_version",
    "schema_version",
    "sequence"
  ],
  "title": "ADLS clean-room sealed submission",
  "type": "object"
}
